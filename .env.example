# =============================================================================
# E-Commerce Data Engineering Pipeline - Environment Configuration Example
# Copy this file to .env and replace placeholder values before deployment.
# =============================================================================

# PostgreSQL Configuration
POSTGRES_DB=ecommerce_dw
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Apache Airflow Configuration
AIRFLOW_FERNET_KEY=change_me
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_EMAIL=admin@example.com
